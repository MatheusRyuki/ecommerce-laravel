APP_NAME="e-Commerce E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=8

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce_e2e
DB_USERNAME=ecommerce_e2e
DB_PASSWORD=e2e-local-apenas

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=e2e_sessao

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=publico_e2e
FILESYSTEM_DISCO_PRODUTOS=publico_e2e
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_LOG_CHANNEL=correio_e2e
MAIL_FROM_ADDRESS="e2e@example.test"
MAIL_FROM_NAME="${APP_NAME}"

E2E_TOKEN=
E2E_APP_PORT=8003

ADMIN_NAME="Administrador E2E"
ADMIN_EMAIL=admin@e2e.test
ADMIN_PASSWORD="SenhaE2e!234"
